@@ -59,6 +61,7 @@ struct iio_dma_buffer_block {
 	size_t bytes_used;
 #ifdef CONFIG_IIO_DMA_BUF_MMAP_LEGACY
 	struct iio_buffer_block block;
+	struct page *rx_page;
 #endif
 
