From: E200 firmware contributors
Subject: [PATCH] usb: ulpi: select the PHY core used by the platform driver

Original source: ADI Linux bf1d49f17fa9e15bc40be2615ef67cdf023f660a
Purpose: fix undefined usb_add_phy_dev/usb_remove_phy when USB_ULPI=y, USB_PHY=n.
Hardware function affected: USB ULPI platform-driver linkage.
Upstream status: local ADI/Xilinx integration fix, not submitted.
Reason local: inherited E200 defconfig exposes the missing dependency on 6.12.
License: GPL-2.0-only, as in the modified Kconfig.

diff --git a/drivers/usb/phy/Kconfig b/drivers/usb/phy/Kconfig
index 38ae54585..fc258067b 100644
--- a/drivers/usb/phy/Kconfig
+++ b/drivers/usb/phy/Kconfig
@@ -160,7 +160,8 @@ config USB_TEGRA_PHY
 
 config USB_ULPI
 	bool "Generic ULPI Transceiver Driver"
-	depends on ARM || ARM64 || COMPILE_TEST || USB_PHY
+	depends on ARM || ARM64 || COMPILE_TEST
+	select USB_PHY
 	select USB_ULPI_VIEWPORT
 	help
 	  Enable this to support ULPI connected USB OTG transceivers which
