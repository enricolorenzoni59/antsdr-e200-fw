+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * E200 opt-in IIOD adapter. DMA ownership moves on CPU0 while CPU1 sends
+ * immutable pages. The standard IIOD READBUF framing is unchanged.
+ */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "e200-rx.h"
+#include "legacy-rx.h"
+#include "tcp-transport.h"
+#include "payload-crc.h"
+#include <pthread.h>
+#include <sched.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <time.h>
+#include <stdio.h>
+
+#define RX_BLOCKS 32
+#define RX_BLOCK_BYTES 1048576
+struct record { void *data; unsigned id; size_t size; };
+struct e200_rx {
+    struct legacy_rx *rx;
+    struct tcp_transport *tcp;
+    pthread_t thread;
+    pthread_mutex_t lock;
+    pthread_cond_t changed;
+    struct record ready[RX_BLOCKS], current;
+    unsigned head, tail, count;
+    unsigned release[RX_BLOCKS], release_count;
+    unsigned flight_id[RX_BLOCKS], slot;
+    bool flight[RX_BLOCKS], held, stop, verify_crc;
+    uint32_t crc, crc_table[256];
+    uint64_t payload_bytes;
+    int error;
+};
+
+/* Only this thread calls legacy dequeue/enqueue. The main thread returns
+ * completed TCP slots through release[], never directly to the DMA engine. */
+static void *producer(void *opaque)
+{
+    struct e200_rx *p = opaque;
+    unsigned owned = 0;
+    for (;;) {
+        unsigned releases[RX_BLOCKS], n;
+        pthread_mutex_lock(&p->lock);
+        while (!p->stop && owned == RX_BLOCKS && !p->release_count)
+            pthread_cond_wait(&p->changed, &p->lock);
+        if (p->stop) {
+            pthread_mutex_unlock(&p->lock);
+            break;
+        }
+        n = p->release_count;
+        for (unsigned i = 0; i < n; i++) releases[i] = p->release[i];
+        p->release_count = 0;
+        pthread_mutex_unlock(&p->lock);
+
+        int error = 0;
+        for (unsigned i = 0; i < n; i++) {
+            error = legacy_rx_enqueue(p->rx, releases[i]);
+            if (error) break;
+            owned--;
+        }
+        struct record record = {0};
+        ssize_t bytes = error ? error :
+            legacy_rx_dequeue(p->rx, &record.data, &record.id);
+        pthread_mutex_lock(&p->lock);
+        if (bytes < 0) {
+            p->error = (int)bytes;
+            pthread_cond_broadcast(&p->changed);
+            pthread_mutex_unlock(&p->lock);
+            break;
+        }
+        owned++;
+        record.size = (size_t)bytes;
+        p->ready[p->tail] = record;
+        p->tail = (p->tail + 1) % RX_BLOCKS;
+        p->count++;
+        pthread_cond_broadcast(&p->changed);
+        pthread_mutex_unlock(&p->lock);
+    }
+    return NULL;
+}
+
+struct e200_rx *e200_rx_open(struct iio_device *dev, struct iio_buffer *buf, int fd)
+{
+    struct e200_rx *p = calloc(1, sizeof(*p));
+    if (!p) return NULL;
+    p->rx = legacy_rx_open(dev, buf, RX_BLOCK_BYTES, RX_BLOCKS);
+    if (!p->rx) goto fail;
+    p->tcp = tcp_transport_create(fd, "borrowed-zerocopy", RX_BLOCK_BYTES, RX_BLOCKS);
+    if (!p->tcp) goto fail;
+    p->verify_crc = getenv("E200_IQ24_CRC") != NULL;
+    if (p->verify_crc) payload_crc_init(p->crc_table);
+    pthread_mutex_init(&p->lock, NULL);
+    pthread_cond_init(&p->changed, NULL);
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    int result = 0;
+#ifndef E200_RX_UNIT_TEST
+    cpu_set_t cpu;
+    CPU_ZERO(&cpu);
+    CPU_SET(0, &cpu);
+    result = pthread_attr_setaffinity_np(&attr, sizeof(cpu), &cpu);
+    if (!result) {
+        CPU_ZERO(&cpu);
+        CPU_SET(1, &cpu);
+        result = pthread_setaffinity_np(pthread_self(), sizeof(cpu), &cpu);
+    }
+#endif
+    if (!result) result = pthread_create(&p->thread, &attr, producer, p);
+    pthread_attr_destroy(&attr);
+    if (result) {
+        pthread_cond_destroy(&p->changed);
+        pthread_mutex_destroy(&p->lock);
+        errno = result;
+        goto fail;
+    }
+    fprintf(stderr, "E200: standard IIOD protocol, 32-block DMA / zero-copy RX enabled\n");
+    return p;
+fail: {
+    int saved = errno;
+    legacy_rx_close(p->rx);
+    tcp_transport_destroy(p->tcp);
+    free(p);
+    errno = saved;
+    return NULL;
+}}
+
+/* Called only by the IIOD connection or its rw thread, never concurrently.
+ * POLLERR on a zero-copy socket also means normal completion notifications. */
+int e200_rx_reap(struct e200_rx *p)
+{
+    return tcp_transport_reap(p->tcp);
+}
+
+ssize_t e200_rx_next(struct e200_rx *p)
+{
+    struct timespec start, now;
+    clock_gettime(CLOCK_MONOTONIC, &start);
+    for (;;) {
+        int result = tcp_transport_reap(p->tcp);
+        if (result) return result;
+        pthread_mutex_lock(&p->lock);
+        for (unsigned i = 0; i < RX_BLOCKS; i++) {
+            if (p->flight[i] && !tcp_transport_slot_pending(p->tcp, i)) {
+                p->release[p->release_count++] = p->flight_id[i];
+                p->flight[i] = false;
+            }
+        }
+        pthread_cond_broadcast(&p->changed);
+        ssize_t bytes = p->error;
+        if (!bytes && p->count && !p->flight[p->slot]) {
+            p->current = p->ready[p->head];
+            p->head = (p->head + 1) % RX_BLOCKS;
+            p->count--;
+            p->held = true;
+            bytes = (ssize_t)p->current.size;
+        }
+        pthread_mutex_unlock(&p->lock);
+        if (bytes) return bytes;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        if (now.tv_sec - start.tv_sec > 6) return -ETIMEDOUT;
+        struct timespec delay = {.tv_nsec = 100000};
+        nanosleep(&delay, NULL);
+    }
+}
+
+ssize_t e200_rx_send(struct e200_rx *p, size_t bytes)
+{
+    if (!p->held || bytes > p->current.size || p->flight[p->slot]) return -EINVAL;
+    uint32_t crc = p->crc;
+    if (p->verify_crc) crc = payload_crc32(crc, p->crc_table, p->current.data, bytes);
+    int result = tcp_transport_send(p->tcp, p->current.data, bytes);
+    if (result) return result;
+    p->crc = crc;
+    p->payload_bytes += bytes;
+    p->flight[p->slot] = true;
+    p->flight_id[p->slot] = p->current.id;
+    p->slot = (p->slot + 1) % RX_BLOCKS;
+    p->held = false;
+    return (ssize_t)bytes;
+}
+
+void e200_rx_close(struct e200_rx *p)
+{
+    if (!p) return;
+    pthread_mutex_lock(&p->lock);
+    p->stop = true;
+    pthread_cond_broadcast(&p->changed);
+    pthread_mutex_unlock(&p->lock);
+    legacy_rx_cancel(p->rx);
+    pthread_join(p->thread, NULL);
+    int result = tcp_transport_finish(p->tcp);
+    const struct tcp_stats *stats = tcp_transport_stats(p->tcp);
+    fprintf(stderr, "E200: zero-copy calls=%llu completed=%llu copied=%llu pending=%llu finish=%d\n",
+            (unsigned long long)stats->calls, (unsigned long long)stats->completed,
+            (unsigned long long)stats->copied_completions,
+            (unsigned long long)stats->pending, result);
+    if (p->verify_crc)
+        fprintf(stderr, "E200: payload bytes=%llu crc32=%08x\n",
+                (unsigned long long)p->payload_bytes, p->crc);
+    /* Stop DMA before unmapping. On socket failure, kernel page references
+     * retain any still-pinned allocation; no pending block is re-enqueued. */
+    legacy_rx_close(p->rx);
+    tcp_transport_destroy(p->tcp);
+    pthread_cond_destroy(&p->changed);
+    pthread_mutex_destroy(&p->lock);
+    free(p);
+}
