+++ b/iiod/legacy-rx.c
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Diagnostic client for the ADI Linux legacy block ABI (pinned Linux 6.12.77).
+ * Struct layout/ioctl numbers mirror include/linux/iio/buffer_impl.h.
+ * libiio configures channels and allocates the pool; this client takes over
+ * explicit dequeue/enqueue so TCP can retain several CPU-owned DMA blocks.
+ */
+#define _POSIX_C_SOURCE 200809L
+#include "legacy-rx.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdbool.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+#define MAX_BLOCKS 32
+struct block { uint32_t id, size, used, type, flags, offset; uint64_t timestamp; };
+_Static_assert(sizeof(struct block) == 32, "legacy IIO block ABI mismatch");
+#define QUERY _IOWR('i', 0xa2, struct block)
+#define ENQUEUE _IOWR('i', 0xa3, struct block)
+#define DEQUEUE _IOWR('i', 0xa4, struct block)
+struct legacy_rx {
+    int fd;
+    atomic_bool cancelled;
+    unsigned count;
+    size_t size;
+    char enable[160];
+    void *data[MAX_BLOCKS];
+    struct block block[MAX_BLOCKS];
+    bool held[MAX_BLOCKS];
+};
+static int retry_ioctl(int fd, unsigned long op, void *arg) {
+    int r; do { r = ioctl(fd, op, arg); } while (r < 0 && errno == EINTR);
+    return r < 0 ? -errno : r;
+}
+static int enable(struct legacy_rx *r, bool on) {
+    int fd = open(r->enable, O_WRONLY | O_CLOEXEC);
+    if (fd < 0) return -errno;
+    ssize_t n = write(fd, on ? "1" : "0", 1);
+    int saved = n == 1 ? 0 : -(n < 0 ? errno : EIO);
+    close(fd); return saved;
+}
+struct legacy_rx *legacy_rx_open(struct iio_device *dev, struct iio_buffer *buffer,
+                                 size_t size, unsigned blocks) {
+    if (blocks < 2 || blocks > MAX_BLOCKS || !size || size > 1048576) {
+        errno = EINVAL; return NULL;
+    }
+    const char *id = iio_device_get_id(dev);
+    if (strncmp(id, "iio:device", 10) || strspn(id + 10, "0123456789") != strlen(id + 10)) {
+        errno = EINVAL; return NULL;
+    }
+    struct legacy_rx *r = calloc(1, sizeof(*r));
+    if (!r) return NULL;
+    atomic_init(&r->cancelled, false);
+    r->size = size; r->fd = iio_buffer_get_poll_fd(buffer);
+    snprintf(r->enable, sizeof(r->enable), "/sys/bus/iio/devices/%s/buffer/enable", id);
+    int ret = r->fd < 0 ? r->fd : enable(r, false);
+    if (ret) goto fail;
+    /* The buffer is stopped before adding these aliases. Requeue its aborted
+     * blocks, then enable acquisition only after all mappings are ready. */
+    for (unsigned i = 0; i < blocks; i++) {
+        r->block[i].id = i;
+        ret = retry_ioctl(r->fd, QUERY, &r->block[i]);
+        if (ret) goto fail;
+        if (r->block[i].id != i || r->block[i].size != size) { ret = -EINVAL; goto fail; }
+        r->data[i] = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, r->fd, r->block[i].offset);
+        if (r->data[i] == MAP_FAILED) { r->data[i] = NULL; ret = -errno; goto fail; }
+        r->count++;
+        r->block[i].used = 0; r->block[i].flags = 0;
+        ret = retry_ioctl(r->fd, ENQUEUE, &r->block[i]);
+        if (ret) goto fail;
+    }
+    ret = enable(r, true);
+    if (ret) goto fail;
+    return r;
+fail:
+    legacy_rx_close(r); errno = -ret; return NULL;
+}
+ssize_t legacy_rx_dequeue(struct legacy_rx *r, void **data, unsigned *id) {
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    time_t deadline = now.tv_sec + 6;
+    for (;;) {
+        if (atomic_load(&r->cancelled)) return -ECANCELED;
+        struct block b = {0};
+        int ret = retry_ioctl(r->fd, DEQUEUE, &b);
+        if (!ret) {
+            if (b.id >= r->count || r->held[b.id] || !b.used || b.used > r->size) return -EIO;
+            r->block[b.id] = b; r->held[b.id] = true;
+            *id = b.id; *data = r->data[b.id]; return b.used;
+        }
+        if (ret != -EAGAIN) return ret;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        if (now.tv_sec >= deadline) return -ETIMEDOUT;
+        struct pollfd p = {.fd = r->fd, .events = POLLIN};
+        ret = poll(&p, 1, 100);
+        if (ret < 0 && errno != EINTR) return -errno;
+        if (ret > 0 && (p.revents & (POLLERR | POLLHUP | POLLNVAL))) return -EIO;
+    }
+}
+int legacy_rx_enqueue(struct legacy_rx *r, unsigned id) {
+    if (id >= r->count || !r->held[id]) return -EINVAL;
+    r->block[id].used = 0; r->block[id].flags = 0;
+    int ret = retry_ioctl(r->fd, ENQUEUE, &r->block[id]);
+    if (!ret) r->held[id] = false;
+    return ret;
+}
+void legacy_rx_cancel(struct legacy_rx *r) { atomic_store(&r->cancelled, true); }
+void legacy_rx_close(struct legacy_rx *r) {
+    if (!r) return;
+    enable(r, false);
+    for (unsigned i = 0; i < r->count; i++) munmap(r->data[i], r->size);
+    free(r);
+}
