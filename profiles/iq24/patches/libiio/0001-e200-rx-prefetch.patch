+#ifndef E200_IIOD_RX_H
+#define E200_IIOD_RX_H
+#include <iio.h>
+struct e200_rx;
+/* Single network reader, RX1 I/Q, 32 legacy DMA blocks of 1 MiB. */
+struct e200_rx *e200_rx_open(struct iio_device *, struct iio_buffer *, int socket_fd);
+ssize_t e200_rx_next(struct e200_rx *);
+ssize_t e200_rx_send(struct e200_rx *, size_t);
+int e200_rx_reap(struct e200_rx *);
